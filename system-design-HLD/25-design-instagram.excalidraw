    {
      "id": "kzJ_NMXJjdAS3EiM6URGY",
      "type": "text",
      "x": 495.80491257131627,
      "y": 596.7935946727008,
      "width": 215.43978881835938,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
