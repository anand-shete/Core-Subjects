      "seed": 1466914127,
      "version": 520,
      "versionNonce": 487798081,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789929207923,
      "created": 1789923272604,
      "link": null,
      "locked": false,
      "text": "- User can see feed of other users\n- User can upload a post \n- User can accept follow requests and follow other users\n- User can search other users and hash tags\n- User can comment and like a post\n- Send Notifications to user based on activity/recommendations",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- User can see feed of other users\n- User can upload a post \n- User can accept follow requests and follow other users\n- User can search other users and hash tags\n- User can comment and like a post\n- Send Notifications to user based on activity/recommendations",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "N2mEDE3H_I6ttq978vsIv",
      "type": "text",
      "x": 495.8049132161064,
      "y": 450.6651958418229,
      "width": 248.33645629882812,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "be9",
      "roundness": null,
      "seed": 256097537,
      "version": 179,
      "versionNonce": 1738942209,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789925994882,
      "created": 1789923969408,
      "link": null,
      "locked": false,
      "text": "\n- Total active users are 1 B\n- DAU = 25% of 1B = 250M\n- Read:Write is 100:1\n- User uploads 1 image everyday",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n- Total active users are 1 B\n- DAU = 25% of 1B = 250M\n- Read:Write is 100:1\n- User uploads 1 image everyday",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
