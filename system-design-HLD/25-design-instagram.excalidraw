      "labelPosition": null
    },
    {
      "id": "jk-dGmC3slr2NfrWMSk-h",
      "type": "text",
      "x": 495.8049129651408,
      "y": 628.2159271820084,
      "width": 520.6730346679688,
      "height": 440,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "beC",
      "roundness": null,
      "seed": 1193743617,
      "version": 1041,
      "versionNonce": 1665655105,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789930096512,
      "created": 1789924437449,
      "link": null,
      "locked": false,
      "text": "1. DAU = 250M\n2. Read:Write is 100:1\n   total reads in single day = 100 x 250M = 25B\n    total writes = 250M\n    \n    read QPS = 25B / 100K = 250K\n    write QPS = 250M/100K = 2500\n    total QPS = 250K\n    Peak QPS = 500K\n\n3. Storage requirements\n   user upload 1 image = 300KB\n    total image uploads = 300KB x 250M = 75 TB\n    for 1 year = 75 x 400 = 30 PB\n\n4. Bandwidth estimation\n    total storage for 1 day = 75 TB\n    \n    Incoming bandwidth = 75TB / 86400 = 0.87 GBps = 6.96 Gbps\n    \n    Read:Write is 100:1\n    Outgoing bandwidth = 100 x 6.96 Gbps =  696 Gbps ",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. DAU = 250M\n2. Read:Write is 100:1\n   total reads in single day = 100 x 250M = 25B\n    total writes = 250M\n    \n    read QPS = 25B / 100K = 250K\n    write QPS = 250M/100K = 2500\n    total QPS = 250K\n    Peak QPS = 500K\n\n3. Storage requirements\n   user upload 1 image = 300KB\n    total image uploads = 300KB x 250M = 75 TB\n    for 1 year = 75 x 400 = 30 PB\n\n4. Bandwidth estimation\n    total storage for 1 day = 75 TB\n    \n    Incoming bandwidth = 75TB / 86400 = 0.87 GBps = 6.96 Gbps\n    \n    Read:Write is 100:1\n    Outgoing bandwidth = 100 x 6.96 Gbps =  696 Gbps ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
